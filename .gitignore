# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
*.tsbuildinfo

# Go 编译产物
*.exe
*.exe~
packages/server-go/tgs

# 运行时数据（SQLite 数据库、会话文件、日志）
data/
*.db
*.db-journal
*.db-wal
*.db-shm
logs/

# 环境变量（含 MASTER_KEY 与密码，绝对不能提交）
.env
.env.local
.env.*.local

# 截图与浏览器临时 profile
# 这些是可再生产物（node scripts/shoot.mjs 一条命令就能重出），
# 10 张 2x PNG 有 5.6MB，不该进版本历史。
packages/web-vue/shots/
.chrome-profile/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
