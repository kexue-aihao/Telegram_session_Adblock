    "@node-rs/argon2": "2.2.1",
    "@tgs/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "pino": "10.3.1",
    "safe-regex": "2.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/safe-regex": "1.1.6",
