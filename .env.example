# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env 后按需修改。所有带「必填」标记的项必须设置，
# 否则服务会在启动时直接退出并打印缺失项。
# ─────────────────────────────────────────────────────────────

# 运行环境：development | production | test
NODE_ENV=development

# 监听地址与端口
HOST=0.0.0.0
PORT=8787

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 面板时区。影响统计的「今天」如何切分与所有时间的展示。
TZ=Asia/Shanghai

# SQLite 数据库文件。Docker 部署时改成 file:/data/app.db 以配合数据卷。
DATABASE_URL=file:./data/app.db

# ── 必填 ──────────────────────────────────────────────────────
# 加密 bot token 的主密钥，必须是 32 字节。
# 生成一个：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ 这个值一旦更换，库里所有已保存的 bot token 都会解不开，
#    需要到面板里重新录入每个机器人的 token。
MASTER_KEY=

# 签名会话 Cookie 的密钥，至少 32 个字符。同样可以用上面的命令生成。
SESSION_SECRET=

# 首次启动用它创建管理员账号。只在「库里还没有管理员」时生效，
# 之后改密码请在面板的「设置」页操作。
# 至少要 8 位，且同时包含字母和数字。
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# ── 可选 ──────────────────────────────────────────────────────

# 设置后机器人改用 webhook 模式；不设置则使用长轮询（自托管的推荐方式，
# 因为多数自托管环境没有公网域名与 HTTPS 证书）。
# PUBLIC_URL=https://panel.example.com
# WEBHOOK_PATH=/tg/webhook
# WEBHOOK_SECRET=

# 前端构建产物目录。留空则自动使用 packages/web/dist。
# WEB_DIST=
